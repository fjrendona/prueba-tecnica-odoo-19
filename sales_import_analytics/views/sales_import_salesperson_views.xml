<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sales_import_salesperson_view_list" model="ir.ui.view">
        <field name="name">sales.import.salesperson.list</field>
        <field name="model">sales.import.salesperson</field>
        <field name="arch" type="xml">
            <list string="Vendedores" editable="bottom">
                <field name="name"/>
                <field name="user_id" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <record id="sales_import_salesperson_view_form" model="ir.ui.view">
        <field name="name">sales.import.salesperson.form</field>
        <field name="model">sales.import.salesperson</field>
        <field name="arch" type="xml">
            <form string="Vendedor">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="user_id"/>
                        <field name="active" invisible="True"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sales_import_salesperson_view_search" model="ir.ui.view">
        <field name="name">sales.import.salesperson.search</field>
        <field name="model">sales.import.salesperson</field>
        <field name="arch" type="xml">
            <search string="Buscar vendedores">
                <field name="name"/>
                <field name="user_id"/>
                <filter name="filter_archived" string="Archivados" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_sales_import_salesperson" model="ir.actions.act_window">
        <field name="name">Vendedores</field>
        <field name="res_model">sales.import.salesperson</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
